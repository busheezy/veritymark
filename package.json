{
  "name": "headwind",
  "version": "0.1.0",
  "description": "Lint Tailwind CSS classes from the command line",
  "bin": {
    "headwind": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && oxlint && oxfmt --check .",
    "format": "oxfmt --write .",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js"
  },
  "dependencies": {
    "@tailwindcss/language-server": "0.16.0",
    "tinyglobby": "0.2.17",
    "vscode-jsonrpc": "9.0.2"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1"
}
